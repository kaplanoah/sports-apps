{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "strictBindCallApply": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["apps", "shared", "worker", "tests", "*.mjs", "types", ".claude/hooks"],
  "exclude": [
    "apps/*/page/js/sortable.min.js",
    "apps/*/page/sw.js",
    "shared/page/push-worker.js",
    "shared/page/offline-worker.js",
    "shared/page/service-worker-steps.js",
    "apps/*/worker/dist"
  ]
}
