{
  "permissions": {
    "allow": [
      "Bash(git push -f origin *:beta)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh pr list --label beta --state open)",
      "Bash(gh pr list --label beta-wait --state open)",
      "Bash(gh pr edit * --add-label beta)",
      "Bash(gh pr edit * --remove-label beta)",
      "Bash(gh pr edit * --add-label beta-wait)",
      "Bash(gh pr edit * --remove-label beta-wait)",
      "mcp__github__add_issue_comment",
      "mcp__github__issue_write",
      "mcp__claude-code-remote__send_message"
    ],
    "deny": [
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(node worker/deploy.mjs *)",
      "Bash(node worker/deploy.mjs)",
      "Bash(node worker/set-app-key.mjs *)",
      "Bash(node worker/set-app-key.mjs)",
      "Bash(node worker/set-access-code.mjs *)",
      "Bash(node worker/set-access-code.mjs)",
      "Bash(node worker/set-page-host.mjs *)",
      "Bash(node worker/set-page-host.mjs)",
      "Bash(node worker/rollback.mjs *)",
      "Bash(node worker/rollback.mjs)",
      "Bash(git push -f origin * *:beta)",
      "Bash(gh pr edit * * --add-label beta)",
      "Bash(gh pr edit * * --remove-label beta)",
      "Bash(gh pr edit * * --add-label beta-wait)",
      "Bash(gh pr edit * * --remove-label beta-wait)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/install-packages.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/one-command.mjs\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-push.mjs\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-limit.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-limit.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/context-limit.mjs\""
          }
        ]
      }
    ]
  }
}
