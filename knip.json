{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "apps/*/page/js/app.js",
    "shared/page/pick-theme.js",
    "apps/*/page/js/gate-theme.js",
    "apps/*/worker/src/index.js",
    "worker/*.mjs",
    "tests/*.test.js",
    "tests/browser/serve.mjs",
    "shared/page/push-worker.js",
    "shared/page/offline-worker.js",
    "shared/page/service-worker-steps.js",
    "shared/page/draw-home-screen-asks.js",
    "shared/page/open-last-tab.js",
    "shared/page/season-header.js",
    "shared/page/show-last-drawn.js",
    "shared/page/slow-load.js",
    "shared/page/gate.js",
    "shared/page/release-guard.js",
    "apps/*/tests/*.test.js",
    "apps/*/tests/browser/*.spec.mjs",
    "apps/*/tests/fixtures/record*.js",
    ".claude/hooks/*.mjs"
  ],
  "project": [
    "apps/*/page/js/**/*.js",
    "apps/*/worker/**/*.{js,mjs}",
    "apps/*/tests/**/*.{js,mjs}",
    "shared/**/*.js",
    "worker/**/*.{js,mjs}",
    "tests/**/*.{js,mjs}",
    "*.mjs",
    ".claude/hooks/*.mjs"
  ],
  "ignore": ["apps/*/page/js/sortable.min.js"]
}
